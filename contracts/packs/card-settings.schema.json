{
  "$defs": {
    "PackContentRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 30,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "activity_id": {
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "title": "Activity Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "definition_sha256",
        "archive_sha256",
        "activity_id"
      ],
      "title": "PackContentRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "content_ref": {
      "$ref": "#/$defs/PackContentRef"
    },
    "locale": {
      "maxLength": 6,
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "title": "Locale",
      "type": "string"
    },
    "item_ids": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Ids",
      "uniqueItems": true
    }
  },
  "required": [
    "content_ref",
    "locale"
  ],
  "title": "CardBlockSettings",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
