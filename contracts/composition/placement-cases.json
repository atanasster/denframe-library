  { "name": "integral float span", "input": { "col_span": 4.0 }, "accept": true },
  { "name": "integral float pinned start", "input": { "col_span": 6, "col_start": 7.0 }, "accept": true },
  { "name": "full width span", "input": { "col_span": 12 }, "accept": true },
  { "name": "column span exactly fits", "input": { "col_span": 6, "col_start": 7 }, "accept": true },
