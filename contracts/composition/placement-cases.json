  {
    "_comment": "Input/output parity cases for one placement hint. Consumed by backend/tests/test_composition_documents.py and frontend/src/composition/appearance.test.ts so the Python and TypeScript parsers cannot drift. Instances where accept is false must be refused by ALL THREE gates: the Pydantic model, the browser parser, and the generated JSON Schema. JSON has a single number type, so `4.0` and `4` are the same document to a browser and to draft 2020-12 `integer`; both parsers must accept integral floats and refuse fractional ones.",
    "name": "empty hint takes defaults",
    "input": {},
    "accept": true
  },
